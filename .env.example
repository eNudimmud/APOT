# Copy to Vercel → Project → Settings → Environment Variables.
# Leave these empty in the repository. Do not commit real values.

# OAuth 2.0 client ID from the X app. Read permission only.
X_CLIENT_ID=

# OAuth 2.0 client secret. Server only. Never put this in the page.
X_CLIENT_SECRET=

# Exact callback registered on the X app.
# Example: https://apot.world/api/x/callback
X_REDIRECT_URI=

# Random string used to sign the session cookie. Example: openssl rand -base64 32
APOT_SESSION_SECRET=
